---
import type { ResumeBasics } from "../lib/resume";
import { TOPTAL_REFERRAL_URL, CONTACT_EMAIL } from "../lib/links";

interface Props {
  basics: ResumeBasics;
}

const { basics } = Astro.props;

const networkIcon: Record<string, string> = {
  Github: "M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.87 10.94c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.5 3.17-1.18 3.17-1.18.64 1.6.24 2.77.12 3.05.74.8 1.18 1.83 1.18 3.09 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z",
  LinkedIn:
    "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z",
};
---

<section id="contact" class="mx-auto max-w-4xl px-6 py-16">
  <h2 class="text-2xl font-bold tracking-tight">Contact</h2>
  <p class="mt-4 max-w-2xl text-slate-700 dark:text-slate-300">
    Open to senior back-end and cloud engineering opportunities. Reach out
    directly or find me on the platforms below.
  </p>
  <div class="mt-8 flex flex-wrap gap-3">
    <a
      href={`mailto:${CONTACT_EMAIL}`}
      class="rounded-full bg-slate-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
    >
      {CONTACT_EMAIL}
    </a>
    {
      basics.profiles.map((profile) => (
        <a
          href={profile.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-full border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 transition-colors hover:border-slate-400 hover:text-slate-900 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-500 dark:hover:text-white"
        >
          {networkIcon[profile.network] && (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="h-4 w-4 fill-current"
            >
              <path d={networkIcon[profile.network]} />
            </svg>
          )}
          {profile.network}
        </a>
      ))
    }
    <a
      href={TOPTAL_REFERRAL_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full border border-indigo-300 bg-indigo-50 px-5 py-2.5 text-sm font-medium text-indigo-700 transition-colors hover:border-indigo-400 hover:bg-indigo-100 dark:border-indigo-800 dark:bg-indigo-950 dark:text-indigo-300 dark:hover:border-indigo-700 dark:hover:bg-indigo-900"
    >
      Hire me via Toptal
    </a>
  </div>
</section>
