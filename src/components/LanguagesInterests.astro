---
import type { ResumeLanguage, ResumeInterest } from "../lib/resume";

interface Props {
  languages: ResumeLanguage[];
  interests: ResumeInterest[];
}

const { languages, interests } = Astro.props;
---

<section class="mx-auto max-w-4xl px-6 py-16">
  <div class="grid gap-10 sm:grid-cols-2">
    <div>
      <h2 class="text-2xl font-bold tracking-tight">Languages</h2>
      <ul class="mt-6 space-y-2">
        {
          languages.map((language) => (
            <li class="flex justify-between text-slate-700 dark:text-slate-300">
              <span>{language.language}</span>
              <span class="text-slate-500 dark:text-slate-400">
                {language.fluency}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="text-2xl font-bold tracking-tight">Interests</h2>
      <ul class="mt-6 space-y-2">
        {
          interests.map((interest) => (
            <li class="text-slate-700 dark:text-slate-300">
              <span class="font-medium">{interest.name}</span>
              {interest.keywords.length > 0 && (
                <span class="text-slate-500 dark:text-slate-400">
                  {" "}
                  &middot; {interest.keywords.join(", ")}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
