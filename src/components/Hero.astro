---
import type { ResumeBasics } from "../lib/resume";
import ToptalBadge from "./ToptalBadge.astro";
import { CONTACT_EMAIL } from "../lib/links";

interface Props {
  basics: ResumeBasics;
}

const { basics } = Astro.props;
---

<section id="top" class="mx-auto max-w-4xl px-6 pb-16 pt-20 sm:pt-28">
  <div class="flex flex-col-reverse items-start gap-10 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-sm font-medium text-indigo-600 dark:text-indigo-400">
        {basics.location.city}, {basics.location.region}
      </p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">
        {basics.name}
      </h1>
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">
        {basics.label}
      </p>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-slate-700 dark:text-slate-300">
        {basics.summary}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={`mailto:${CONTACT_EMAIL}`}
          class="rounded-full bg-slate-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
        >
          Contact me
        </a>
        <a
          href="#experience"
          class="rounded-full border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 transition-colors hover:border-slate-400 hover:text-slate-900 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-500 dark:hover:text-white"
        >
          View experience
        </a>
      </div>
    </div>
    <div class="flex flex-shrink-0 flex-col items-center gap-6">
      {
        basics.image && (
          <img
            src={basics.image}
            alt={basics.name}
            class="h-28 w-28 rounded-full object-cover ring-4 ring-slate-100 dark:ring-slate-800 sm:h-36 sm:w-36"
          />
        )
      }
      <ToptalBadge />
    </div>
  </div>
</section>
