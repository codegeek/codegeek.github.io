---
import type { ResumeEducation } from "../lib/resume";
import { formatDateRange } from "../lib/dates";

interface Props {
  education: ResumeEducation[];
}

const { education } = Astro.props;
---

<section id="education" class="mx-auto max-w-4xl px-6 py-16">
  <h2 class="text-2xl font-bold tracking-tight">Education</h2>
  <div class="mt-8 space-y-6">
    {
      education.map((entry) => (
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <div>
            <h3 class="text-lg font-semibold">
              {entry.studyType} in {entry.area}
            </h3>
            <p class="text-slate-600 dark:text-slate-400">
              {entry.institution}
            </p>
          </div>
          <span class="text-sm text-slate-500 dark:text-slate-400">
            {formatDateRange(entry.startDate, entry.endDate)}
          </span>
        </div>
      ))
    }
  </div>
</section>
