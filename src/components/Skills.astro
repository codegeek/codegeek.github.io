---
import type { ResumeSkill } from "../lib/resume";

interface Props {
  skills: ResumeSkill[];
}

const { skills } = Astro.props;
---

<section id="skills" class="mx-auto max-w-4xl px-6 py-16">
  <h2 class="text-2xl font-bold tracking-tight">Skills</h2>
  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    {
      skills.map((skill) => (
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
            {skill.name}
            <span class="ml-2 font-normal normal-case text-slate-400 dark:text-slate-500">
              &middot; {skill.level}
            </span>
          </h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {skill.keywords.map((keyword) => (
              <span class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                {keyword}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
