---
import type { ResumeWork } from "../lib/resume";
import { formatDateRange } from "../lib/dates";

interface Props {
  work: ResumeWork[];
}

const { work } = Astro.props;
---

<section id="experience" class="mx-auto max-w-4xl px-6 py-16">
  <h2 class="text-2xl font-bold tracking-tight">Experience</h2>
  <ol class="mt-8 space-y-10 border-l border-slate-200 dark:border-slate-800">
    {
      work.map((job) => (
        <li class="relative pl-8">
          <span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full bg-indigo-500" />
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="text-lg font-semibold">
              {job.position} &middot;{" "}
              {job.url ? (
                <a
                  href={job.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-indigo-600 hover:underline dark:text-indigo-400"
                >
                  {job.name}
                </a>
              ) : (
                job.name
              )}
            </h3>
            <span class="text-sm text-slate-500 dark:text-slate-400">
              {formatDateRange(job.startDate, job.endDate)}
            </span>
          </div>
          {job.location && (
            <p class="text-sm text-slate-500 dark:text-slate-400">
              {job.location}
            </p>
          )}
          {job.summary && (
            <p class="mt-3 text-slate-700 dark:text-slate-300">
              {job.summary}
            </p>
          )}
          {job.highlights && job.highlights.length > 0 && (
            <ul class="mt-3 list-disc space-y-1.5 pl-5 text-slate-700 dark:text-slate-300">
              {job.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>
</section>
